# =============================================================================
# tcg-sniper: configuração
#
# Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
# O .env nunca vai para o git. O Docker Compose e o `uv run` leem o mesmo arquivo.
#
# Antes de subir, troque obrigatoriamente:
#   ADMIN_SENHA, VNC_SENHA, EVOLUTION_API_KEY, HOST_PUBLICO
# e, depois de conectar o WhatsApp (passo 5 do README):
#   WHATSAPP_GRUPO_ADMIN
#
# Todo o resto já vem com um padrão que funciona.
# =============================================================================


# -----------------------------------------------------------------------------
# Acesso
# -----------------------------------------------------------------------------

# Senha da página de admin (http://<HOST_PUBLICO>:8000). O usuário pode ser qualquer um.
# Vazia ou "trocar-esta-senha": o admin não sobe.
ADMIN_SENHA=trocar-esta-senha

# Senha do noVNC (http://<HOST_PUBLICO>:6080/vnc.html), a tela remota do Chromium usada
# para resolver um desafio do Cloudflare. O VNC só usa os 8 primeiros caracteres.
# Vazia ou "trocar-esta-senha": o coletor não sobe.
VNC_SENHA=trocar-esta-senha

# IP deste PC na rede local (ex.: 192.168.0.10). Vai nos links das mensagens do WhatsApp
# (admin e noVNC), para abrir direto do celular. No Windows: `ipconfig`, "Endereço IPv4".
HOST_PUBLICO=192.168.0.10


# -----------------------------------------------------------------------------
# WhatsApp (Evolution API)
#
# O coletor manda mensagens de texto para um grupo de WhatsApp de administração:
# desafio do Cloudflare, coleta com falha, erro inesperado, produtos novos no catálogo e
# um resumo ao fim de cada coleta. Sem os valores abaixo, as mensagens vão só para o log.
# O projeto só envia texto: não lê mensagens nem guarda mídia.
# -----------------------------------------------------------------------------

# Chave da Evolution API. É a mesma usada para subir a Evolution (AUTHENTICATION_API_KEY
# no docker-compose.yml) e nos comandos curl do README. Use um valor longo e aleatório.
# Vazia ou "trocar-esta-chave": as mensagens vão só para o log.
EVOLUTION_API_KEY=trocar-esta-chave

# Nome da instância criada na Evolution (o "instanceName" do /instance/create).
EVOLUTION_INSTANCIA=tcg-sniper

# ID do grupo admin, no formato 120363...@g.us (passo 5 do README).
# Vazio: as mensagens do admin vão só para o log.
WHATSAPP_GRUPO_ADMIN=

# Reservado para o futuro grupo de oportunidades. Ainda não usado.
WHATSAPP_GRUPO_OPORTUNIDADES=

# Endereço da Evolution API. Só vale para quem roda com `uv run` fora do Docker:
# dentro do Docker o compose usa http://evolution:8080.
EVOLUTION_URL=http://localhost:8080


# -----------------------------------------------------------------------------
# Agendamento e ritmo da coleta
# -----------------------------------------------------------------------------

# Fuso usado no horário da coleta e nas datas mostradas no admin e nas mensagens.
FUSO=America/Sao_Paulo

# Horário da coleta diária (HH:MM, no FUSO acima).
COLETA_HORA=10:00

# Variação aleatória em minutos para mais ou para menos no horário (0 a 180).
# Com 10:00 e 30, a coleta começa entre 09:30 e 10:30.
COLETA_JITTER_MIN=30

# Pausa aleatória, em segundos, entre uma página e outra da LigaMagic e antes de cada
# clique em "Exibir mais". PAUSA_MIN_S não pode ser maior que PAUSA_MAX_S.
# Reduzir as pausas aumenta a chance de desafio do Cloudflare.
PAUSA_MIN_S=8
PAUSA_MAX_S=20

# Percentual de falhas (0 a 100) a partir do qual a coleta é marcada como "falha" e o
# grupo admin é avisado. Até esse valor, inclusive, ela fica "parcial".
LIMITE_FALHA_PCT=50


# -----------------------------------------------------------------------------
# LigaMagic
# -----------------------------------------------------------------------------

# Categorias de selados de Magic varridas todo dia (IDs separados por vírgula).
# Se uma categoria passar a falhar todo dia (ficou vazia ou mudou), tire-a daqui.
LIGA_CATEGORIAS=10,11,12,13,14,15,16,17,19,21,22,31,36,37,47,50,51,52,55,56

# Modelo da URL de listagem de uma categoria; {categ} é trocado pelo ID.
LIGA_URL_LISTAGEM=https://www.ligamagic.com.br/?view=cards/search&card=categ%3D{categ}+searchprod%3D1&tipo=1

# Máximo de cliques em "Exibir mais" por categoria (1 a 500). Cada clique mostra mais 40
# produtos. Atingir o limite conta como falha da categoria.
LIGA_MAX_CLIQUES=50


# -----------------------------------------------------------------------------
# Banco e pastas (só para desenvolvimento com `uv run`)
#
# Dentro do Docker o compose sobrescreve estes dois valores (postgres:5432 e /data);
# não precisa mexer neles para usar o projeto.
# -----------------------------------------------------------------------------

# Usuário e senha "tcg" são os do Postgres local criado pelo docker-compose.yml (que só
# escuta em 127.0.0.1). Não é segredo: se mudar aqui, mude também no compose.
DATABASE_URL=postgresql+psycopg://tcg:tcg@127.0.0.1:5432/tcg

# Perfil do Chromium e HTMLs das páginas que falharam (em falhas/).
DIR_DADOS=./dados
