DATABASE_URL=postgresql+psycopg://tcg:tcg@127.0.0.1:5432/tcg
ADMIN_SENHA=trocar-esta-senha
# VNC: só os 8 primeiros caracteres valem; vazia ou o valor padrão impedem o coletor de subir.
VNC_SENHA=trocar-esta-senha
COLETA_HORA=10:00
COLETA_JITTER_MIN=30
PAUSA_MIN_S=8
PAUSA_MAX_S=20
LIMITE_FALHA_PCT=50
FUSO=America/Sao_Paulo
LIGA_CATEGORIAS=10,11,12,13,14,15,16,17,19,21,22,31,36,37,47,50,51,52,55,56
LIGA_URL_LISTAGEM=https://www.ligamagic.com.br/?view=cards/search&card=categ%3D{categ}+searchprod%3D1&tipo=1
LIGA_MAX_CLIQUES=50
DIR_DADOS=./dados
# IP do PC na rede local; usado nos links das mensagens do WhatsApp (admin e noVNC).
HOST_PUBLICO=192.168.0.10
# Mensagens no grupo admin do WhatsApp (desafio do Cloudflare, coleta com falha, erro inesperado,
# produtos novos no catálogo e o resumo ao fim de cada job) exigem os quatro valores abaixo:
# EVOLUTION_URL, EVOLUTION_API_KEY, EVOLUTION_INSTANCIA (o nome da instância criada na Evolution
# API, igual ao usado em /instance/create) e WHATSAPP_GRUPO_ADMIN (ID do grupo, "...@g.us").
# Não há flag para o resumo: com o WhatsApp configurado, ele sai sempre que o job termina sem
# desafio e sem erro. Ver "Subir tudo" no README.
EVOLUTION_URL=http://localhost:8080
# Vazia ou o valor padrão: os alertas vão só para o log.
EVOLUTION_API_KEY=trocar-esta-chave
EVOLUTION_INSTANCIA=tcg-sniper
# Vazio: os alertas do admin vão só para o log.
WHATSAPP_GRUPO_ADMIN=
# Ainda não usado (sub-projeto das mensagens de oportunidade).
WHATSAPP_GRUPO_OPORTUNIDADES=
