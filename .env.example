# =============================================================================
# tcg-sniper: configuração
#
# Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
# O .env nunca vai para o git. O Docker Compose e o `uv run` leem o mesmo arquivo.
#
# Antes de subir, troque obrigatoriamente:
#   ADMIN_SENHA, VNC_SENHA, EVOLUTION_API_KEY, SEGREDO_API
#
# Aqui ficam só senhas e infraestrutura. IP deste PC, WhatsApp (instância e grupos),
# horário e categorias da coleta e o resto da operação se ajustam em Configurações no admin
# (http://<IP deste PC>:8000/configuracoes).
# =============================================================================


# -----------------------------------------------------------------------------
# Acesso
# -----------------------------------------------------------------------------

# Senha da página de admin (http://<IP deste PC>:8000). O usuário pode ser qualquer um.
# Vazia ou "trocar-esta-senha": o admin não sobe.
ADMIN_SENHA=trocar-esta-senha

# Senha do noVNC (http://<IP deste PC>:6080/vnc.html), a tela remota do Chromium usada
# para resolver um desafio do Cloudflare. O VNC só usa os 8 primeiros caracteres.
# Vazia ou "trocar-esta-senha": o coletor não sobe.
VNC_SENHA=trocar-esta-senha

# Chave secreta do login do site novo (serviço api; o site abre em http://localhost:8090 neste PC): o banco guarda o código
# de acesso, o token da sessão e o número dos pedidos só como HMAC com esta chave. Obrigatória: vazia,
# "trocar-este-segredo" ou com menos de 32 caracteres, a api não sobe. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Trocar a chave derruba todas as sessões e códigos abertos (todos entram de novo pelo WhatsApp).
SEGREDO_API=trocar-este-segredo


# -----------------------------------------------------------------------------
# WhatsApp (Evolution API)
#
# O coletor manda mensagens de texto para grupos de WhatsApp: desafio do Cloudflare, coleta
# com falha, erro inesperado, produtos novos no catálogo, um resumo ao fim de cada coleta e as
# ofertas. A instância e os grupos ficam em Configurações → Geral; aqui ficam só a chave e o
# endereço. Sem a chave aqui, ou sem instância e grupo em Configurações → Geral, as mensagens
# ficam pendentes na tela Mensagens do admin, com o motivo em "Último erro" (veja também
# `docker compose logs notificador`).
# O projeto só envia texto: não lê mensagens nem guarda mídia.
# -----------------------------------------------------------------------------

# Chave da Evolution API. É a mesma usada para subir a Evolution (AUTHENTICATION_API_KEY
# no docker-compose.yml) e nos comandos curl do README. Use um valor longo e aleatório.
# Vazia ou "trocar-esta-chave": as mensagens ficam pendentes (tela Mensagens).
EVOLUTION_API_KEY=trocar-esta-chave

# Endereço da Evolution API. Só vale para quem roda com `uv run` fora do Docker:
# dentro do Docker o compose usa http://evolution:8080.
EVOLUTION_URL=http://localhost:8080


# -----------------------------------------------------------------------------
# IA (OpenAI)
#
# O casador pergunta à IA se cada anúncio pendente da Amazon é o produto sugerido da LigaMagic.
# Liga, desliga, tetos de gasto e modo automático ficam em Configurações → IA no admin.
# -----------------------------------------------------------------------------

# chave da API da OpenAI para o casador (IA); vazia, a IA não roda
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# Backup fora do PC (Cloudflare R2)
#
# O backup diário do banco fica em dados/backups/ e uma cópia vai para um bucket do R2:
# diários em diario/ e semanais em semanal/. Vazios: o backup só fica no PC.
#
# Na Cloudflare (R2 Object Storage):
#   1. Crie um bucket privado (sem acesso público nem domínio), ex.: tcg-sniper-backups.
#   2. No bucket, Settings → Object lifecycle rules: apagar o prefixo diario/ depois de
#      7 dias e o prefixo semanal/ depois de 35 dias.
#   3. Manage R2 API Tokens → Create API token: permissão "Object Read & Write", só para
#      esse bucket, TTL "Forever". A tela mostra o Access Key ID e o Secret Access Key
#      (o secret aparece uma vez só; o "Token value" não é usado aqui).
# -----------------------------------------------------------------------------

# Account ID da Cloudflare (página inicial do R2, ou o <id> em <id>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=

# Access Key ID e Secret Access Key do token do R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nome do bucket
R2_BUCKET=tcg-sniper-backups


# -----------------------------------------------------------------------------
# Imagens dos produtos e anúncios (área de negócio)
#
# Bucket PÚBLICO só de imagens; nunca o dos backups (que é privado). O serviço manutencao
# copia as fotos da Liga e da Amazon para cá, até 100 por hora. Vazio: as telas saem sem foto.
# Usa o mesmo R2_ACCOUNT_ID. Token: o próprio abaixo, ou (vazio) o dos backups com este bucket incluído.
# -----------------------------------------------------------------------------
R2_BUCKET_IMAGENS=
R2_IMAGENS_ACCESS_KEY_ID=
R2_IMAGENS_SECRET_ACCESS_KEY=
# endereço público do bucket, sem barra no fim: https://<bucket>.r2.dev ou https://img.<domínio>
URL_PUBLICA_IMAGENS=


# -----------------------------------------------------------------------------
# Banco e pastas (só para desenvolvimento com `uv run`)
#
# Dentro do Docker o compose sobrescreve estes dois valores (postgres:5432 e /data);
# não precisa mexer neles para usar o projeto.
# -----------------------------------------------------------------------------

# Usuário e senha "tcg" são os do Postgres local criado pelo docker-compose.yml (que só
# escuta em 127.0.0.1). Não é segredo: se mudar aqui, mude também no compose.
DATABASE_URL=postgresql+psycopg://tcg:tcg@127.0.0.1:5432/tcg

# Perfil do Chromium e HTMLs das páginas que falharam (em falhas/).
DIR_DADOS=./dados
