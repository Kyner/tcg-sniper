# Serviço `web`: serve o build do front (Vite) e repassa /api para o serviço api (mesma origem: sem CORS).
# API_ALVO muda o destino (padrão: api:8100, o nome do serviço na rede do compose).
{
	admin off
	auto_https off
}

:8090 {
	encode gzip

	handle /api/* {
		reverse_proxy {$API_ALVO:api:8100}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		# Os arquivos do build têm hash no nome (mudam a cada deploy): podem ficar no cache para sempre.
		# O resto (index.html e as rotas do React) sempre confere com o servidor, senão o navegador
		# segue abrindo a versão anterior depois de um deploy.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pagina not path /assets/*
		header @pagina Cache-Control "no-cache"
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		# Só arquivos do próprio site: nada de script ou estilo inline nem de fora (o tema inicial é
		# /tema-inicial.js). img-src data: para os ícones SVG embutidos no CSS do DaisyUI;
		# {$URL_PUBLICA_IMAGENS} é o host público das imagens (vazia, fica só 'self' data:).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: {$URL_PUBLICA_IMAGENS}; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}
